      "pluginVersion": "12.4.8",
      "targets": [
        {
          "azureLogAnalytics": {
            "query": "InsightsMetrics\n| where $__timeFilter(TimeGenerated)\n| where Namespace == 'LogicalDisk'\n| extend Mount = tostring(todynamic(Tags)['vm.azm.ms/mountId'])\n| extend DiskSizeMB = todouble(todynamic(Tags)['vm.azm.ms/diskSizeMB'])\n| where isnotempty(Mount)\n| where Mount !startswith '/snap/' and Mount !startswith '/sys/'\n| where '${computer:raw}' == '*' or Computer in (${computer:singlequote})\n| where '${mount:raw}' == '*' or Mount in (${mount:singlequote})\n| summarize AvgIOPS = avgif(Val, Name == 'TransfersPerSecond'), PeakIOPS = maxif(Val, Name == 'TransfersPerSecond'), AvgThroughputMBps = avgif(Val, Name == 'BytesPerSecond') / 1024 / 1024, PeakThroughputMBps = maxif(Val, Name == 'BytesPerSecond') / 1024 / 1024, AvgLatencyMs = avgif(Val, Name == 'TransferLatencyMs'), PeakLatencyMs = maxif(Val, Name == 'TransferLatencyMs'), LowestFreePercent = minif(Val, Name == 'FreeSpacePercentage'), DiskSizeMB = max(DiskSizeMB), LastSeen = max(TimeGenerated) by Computer, Mount, _ResourceId\n| extend ResourceType = case(_ResourceId has '/microsoft.hybridcompute/machines/', 'Azure Arc', _ResourceId has '/microsoft.compute/virtualmachines/', 'Azure VM', 'Other')\n| extend UsedPercent = 100.0 - LowestFreePercent\n| project Computer, ResourceType, Mount, DiskSizeGB = round(DiskSizeMB / 1024, 1), UsedPercent = round(UsedPercent, 1), AvgIOPS = round(AvgIOPS, 1), PeakIOPS = round(PeakIOPS, 1), AvgThroughputMBps = round(AvgThroughputMBps, 2), PeakThroughputMBps = round(PeakThroughputMBps, 2), AvgLatencyMs = round(AvgLatencyMs, 2), PeakLatencyMs = round(PeakLatencyMs, 2), LastSeen\n| order by PeakIOPS desc",
            "resource": "__WORKSPACE_RESOURCE_ID__",
            "resultFormat": "table"
          },
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "__AZURE_MONITOR_DATASOURCE_UID__"
          },
