    {
      "type": 1,
      "name": "DiskVsVmHeading",
      "content": {
        "json": "## Provisioned limits (reference)\n\nProvisioned per-disk limits and their sum across all disks, plus the absolute VM SKU maximums. When the summed disk limits exceed the VM SKU maximums, the disks are over-provisioned and the VM throttles first. Series are split by Azure data-disk LUN, not by guest drive letter."
      }
    },
    {
      "type": 3,
      "name": "DiskProvisionedLimits",
      "content": {
        "version": "KqlItem/1.0",
        "query": "where type =~ 'microsoft.compute/disks' and isnotempty(managedBy) and managedBy =~ '{VirtualMachines}'\n| extend VM = tostring(split(managedBy, '/')[-1]), Sku = tostring(sku.name), SizeGiB = toint(properties.diskSizeGB)\n| extend Tier = coalesce(tostring(properties.tier), case(Sku in~ ('Premium_LRS', 'Premium_ZRS'), case(SizeGiB <= 4, 'P1', SizeGiB <= 8, 'P2', SizeGiB <= 16, 'P3', SizeGiB <= 32, 'P4', SizeGiB <= 64, 'P6', SizeGiB <= 128, 'P10', SizeGiB <= 256, 'P15', SizeGiB <= 512, 'P20', SizeGiB <= 1024, 'P30', SizeGiB <= 2048, 'P40', SizeGiB <= 4096, 'P50', SizeGiB <= 8192, 'P60', SizeGiB <= 16384, 'P70', 'P80'), Sku in~ ('StandardSSD_LRS', 'StandardSSD_ZRS'), case(SizeGiB <= 4, 'E1', SizeGiB <= 8, 'E2', SizeGiB <= 16, 'E3', SizeGiB <= 32, 'E4', SizeGiB <= 64, 'E6', SizeGiB <= 128, 'E10', SizeGiB <= 256, 'E15', SizeGiB <= 512, 'E20', SizeGiB <= 1024, 'E30', SizeGiB <= 2048, 'E40', SizeGiB <= 4096, 'E50', SizeGiB <= 8192, 'E60', SizeGiB <= 16384, 'E70', 'E80'), Sku =~ 'Standard_LRS', case(SizeGiB <= 32, 'S4', SizeGiB <= 64, 'S6', SizeGiB <= 128, 'S10', SizeGiB <= 256, 'S15', SizeGiB <= 512, 'S20', SizeGiB <= 1024, 'S30', SizeGiB <= 2048, 'S40', SizeGiB <= 4096, 'S50', SizeGiB <= 8192, 'S60', SizeGiB <= 16384, 'S70', 'S80'), 'Configurable'))\n| extend DiskType = strcat(Sku, ' (', Tier, ')')\n| project VM, DiskName = name, DiskType, SizeGiB, MaxIOPS = toint(properties.diskIOPSReadWrite), MaxThroughputMBps = toint(properties.diskMBpsReadWrite)\n| order by VM asc, MaxIOPS desc",
        "size": 0,
        "title": "Provisioned per-disk limits (disk SKU)",
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": [
          "value::all"
        ],
        "visualization": "table",
        "gridSettings": {
          "filter": true,
          "showExportToExcel": true,
          "labelSettings": [
            {
              "columnId": "DiskType",
              "label": "Disk type / tier"
            },
            {
              "columnId": "SizeGiB",
              "label": "Size (GiB)"
            },
            {
              "columnId": "MaxIOPS",
              "label": "Max IOPS"
            },
            {
              "columnId": "MaxThroughputMBps",
              "label": "Max throughput (MB/s)"
            }
          ]
        }
      }
    },
    {
      "type": 3,
      "name": "VmTotalProvisioned",
      "content": {
        "version": "KqlItem/1.0",
        "query": "where type =~ 'microsoft.compute/disks' and isnotempty(managedBy) and managedBy =~ '{VirtualMachines}'\n| extend VM = tostring(split(managedBy, '/')[-1])\n| summarize Disks = count(), TotalProvisionedIOPS = sum(toint(properties.diskIOPSReadWrite)), TotalProvisionedThroughputMBps = sum(toint(properties.diskMBpsReadWrite)) by VM\n| order by VM asc",
        "size": 0,
        "title": "Total provisioned limits across all disks",
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": [
          "value::all"
        ],
        "visualization": "table",
        "gridSettings": {
          "filter": true,
          "showExportToExcel": true,
          "labelSettings": [
            {
              "columnId": "TotalProvisionedIOPS",
              "label": "Total max IOPS (all disks)"
            },
            {
              "columnId": "TotalProvisionedThroughputMBps",
              "label": "Total max throughput (MB/s, all disks)"
            }
          ]
        }
      }
    },
