    {
      "type": 1,
      "name": "DiskVsVmHeading",
      "content": {
        "json": "## Provisioned limits (reference)\n\nProvisioned per-disk limits and their sum across all disks, plus the absolute VM SKU maximums. When the summed disk limits exceed the VM SKU maximums, the disks are over-provisioned and the VM throttles first. Series are split by Azure data-disk LUN, not by guest drive letter."
      }
    },
    {
      "type": 3,
      "name": "DiskProvisionedLimits",
      "content": {
        "version": "KqlItem/1.0",
        "query": "where type =~ 'microsoft.compute/disks' and isnotempty(managedBy) and managedBy contains 'virtualMachines'\n| extend VM = tostring(split(managedBy, '/')[-1])\n| project VM, DiskName = name, Sku = tostring(sku.name), SizeGiB = toint(properties.diskSizeGB), MaxIOPS = toint(properties.diskIOPSReadWrite), MaxThroughputMBps = toint(properties.diskMBpsReadWrite)\n| order by VM asc, MaxIOPS desc",
        "size": 0,
        "title": "Provisioned per-disk limits (disk SKU)",
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": [
          "value::all"
        ],
        "visualization": "table",
        "gridSettings": {
          "filter": true,
          "showExportToExcel": true,
          "labelSettings": [
            {
              "columnId": "SizeGiB",
              "label": "Size (GiB)"
            },
            {
              "columnId": "MaxIOPS",
              "label": "Max IOPS"
            },
            {
              "columnId": "MaxThroughputMBps",
              "label": "Max throughput (MB/s)"
            }
          ]
        }
      }
    },
    {
      "type": 3,
      "name": "VmTotalProvisioned",
      "content": {
        "version": "KqlItem/1.0",
        "query": "where type =~ 'microsoft.compute/disks' and isnotempty(managedBy) and managedBy contains 'virtualMachines'\n| extend VM = tostring(split(managedBy, '/')[-1])\n| summarize Disks = count(), TotalProvisionedIOPS = sum(toint(properties.diskIOPSReadWrite)), TotalProvisionedThroughputMBps = sum(toint(properties.diskMBpsReadWrite)) by VM\n| order by VM asc",
        "size": 0,
        "title": "Total provisioned limits across all disks",
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": [
          "value::all"
        ],
        "visualization": "table",
        "gridSettings": {
          "filter": true,
          "showExportToExcel": true,
          "labelSettings": [
